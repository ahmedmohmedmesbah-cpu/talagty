# PostgreSQL for production. SQLite works locally without configuration.
DATABASE_URL=sqlite:///./talagty.db
# Comma-separated origins. Set this to the deployed GitHub Pages URL in production.
ALLOWED_ORIGINS=https://ahmedmohmedmesbah-cpu.github.io
# Change all three values before any public deployment.
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@talagty.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
